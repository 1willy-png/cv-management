@model IEnumerable<CvManagement.Models.CVSubmission>

@{
    ViewData["Title"] = "All CV Submissions";
}

<h1 class="mb-4">All CV Submissions</h1>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Position</th>
            <th>Submitted</th>
            <th>CV</th>
            <th>User</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.FirstName @item.LastName</td>
                <td>@item.Email</td>
                <td>@item.Position</td>
                <td>@item.SubmittedAt.ToString("yyyy-MM-dd HH:mm")</td>
                <td>
                    <a href="@item.CVFileUrl" target="_blank" class="btn btn-sm btn-outline-primary">View CV</a>
                </td>
                <td>@item.User?.UserName</td>
                <td>
                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Are you sure?');">
                        <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>