@model CvManagement.Models.CVSubmission

@{
    ViewData["Title"] = "Submit Your CV";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-primary text-white text-center py-4 rounded-top-4">
                    <h2 class="fw-bold mb-1">📄 CV Application Form</h2>
                    <p class="mb-0 fs-5">Do you want to work with us? Please fill in your details below.</p>
                </div>
                <div class="card-body p-5">
                    <form asp-action="Create" enctype="multipart/form-data" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="row g-4">
                            <div class="col-md-6">
                                <label asp-for="FirstName" class="form-label fw-semibold"></label>
                                <input asp-for="FirstName" class="form-control form-control-lg rounded-3" placeholder="Enter first name" />
                                <span asp-validation-for="FirstName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="LastName" class="form-label fw-semibold"></label>
                                <input asp-for="LastName" class="form-control form-control-lg rounded-3" placeholder="Enter last name" />
                                <span asp-validation-for="LastName" class="text-danger small"></span>
                            </div>
                        </div>

    
    <div class="mt-4">
    <label asp-for="Email" class="form-label fw-semibold"></label>
    <input asp-for="Email" class="form-control form-control-lg rounded-3" placeholder="Enter your email address" />
    <span asp-validation-for="Email" class="text-danger small"></span>
</div>
                        <div class="mt-4">
                            <label asp-for="Position" class="form-label fw-semibold"></label>
                            <input asp-for="Position" class="form-control form-control-lg rounded-3" placeholder="e.g. Software Developer" />
                            <span asp-validation-for="Position" class="text-danger small"></span>
                        </div>

                        <div class="mt-4">
                            <label asp-for="AdditionalInfo" class="form-label fw-semibold"></label>
                            <textarea asp-for="AdditionalInfo" class="form-control form-control-lg rounded-3" rows="3" placeholder="Any additional information..."></textarea>
                            <span asp-validation-for="AdditionalInfo" class="text-danger small"></span>
                        </div>

                        <div class="mt-4">
                            <label class="form-label fw-semibold">Upload your CV Here</label>
                            <div class="border-2 border-dashed rounded-4 p-5 text-center bg-light" style="border-style: dashed; border-color: #0d6efd;">
                                <i class="bi bi-cloud-upload fs-1 text-primary"></i>
                                <p class="mt-3 mb-2">Drag and drop your file here or click to browse</p>
                                <input type="file" name="cvFile" class="form-control" accept=".pdf,.doc,.docx" required />
                                <small class="text-muted">Supported formats: PDF, DOC, DOCX (max 10MB)</small>
                            </div>
                        </div>

                        <div class="mt-5 d-grid">
                            <button type="submit" class="btn btn-primary btn-lg rounded-4 py-3 fw-semibold">
                                <i class="bi bi-send me-2"></i>Submit CV
                            </button>
                        </div>
                    </form>
                </div>
                <div class="card-footer bg-light text-center py-3 rounded-bottom-4 text-muted">
                    Your information is secure and will only be used for recruitment purposes.
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}